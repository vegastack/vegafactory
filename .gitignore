# Dependencies
node_modules/

# Build outputs (regenerated by prepack/build)
dist/
packages/dashboard/.next/
packages/dashboard/dist-standalone/
packages/dashboard/next-env.d.ts
packages/dashboard/tsconfig.tsbuildinfo
packages/cli/skill/
packages/cli/skill-integrity.json

# Local packing and scratch output
work/
*.tgz

# Tool caches and session artifacts
.turbo/
.claude/
.vegastack/.worktrees/
.vegastack/.tmp/

# Eval runs — claude plugin eval results and agentskills.io workspaces
**/evals/results/
*-workspace/

# Local credentials (the design registry's CF Access service tokens)
.env*.local

# OS noise
.DS_Store
docs/research/

# Local Worker secrets (the broker reads the App key from a Secrets Store binding in production)
.dev.vars

#!/bin/sh
# Fast checks before every commit (validators, lint, typecheck) — a few seconds.
# Tests run while building (bun run test:affected) and in the merge queue (full suite).
# The checks run on a copy of exactly what is staged, so unstaged or untracked files
# cannot make a commit pass. Quiet when everything passes.
if git diff --cached --quiet; then exit 0; fi
root=$(git rev-parse --show-toplevel) || exit 1
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --force --prefix="$snapshot/" || exit 1
# Reuse installed dependencies instead of installing into the snapshot.
find "$root" \( -path "$root/.vegastack" -o -path "$root/.git" \) -prune -o -name node_modules -type d -print -prune | while IFS= read -r dir; do
  rel=${dir#"$root"/}
  mkdir -p "$snapshot/$(dirname "$rel")"
  ln -s "$dir" "$snapshot/$rel"
done
log="$snapshot/.pre-commit.log"
if (cd "$snapshot" && bun run --silent check:fast) >"$log" 2>&1; then exit 0; fi
cat "$log"
echo "pre-commit: fast checks failed on the staged files — fix the problems above and commit again." >&2
exit 1

{
  "name": "@vegastack/vegafactory",
  "version": "0.20.0",
  "description": "VegaFactory CLI for installing Agent Skills and running local development workflows",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vegastack/vegafactory.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vegastack/vegafactory#readme",
  "bugs": "https://github.com/vegastack/vegafactory/issues",
  "author": "VegaStack",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "skill",
    "architecture",
    "vegastack"
  ],
  "bin": {
    "vegafactory": "dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "skill-integrity.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "bun scripts/sync-skill.mjs",
    "build": "bun run sync && bun build src/index.ts --target=node --outfile dist/index.js && chmod +x dist/index.js",
    "lint": "bun scripts/lint.mjs",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "prepack": "node ../../scripts/release.mjs validate",
    "pack:local": "node ../../scripts/release.mjs pack ../../work/packed"
  }
}

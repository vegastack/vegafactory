{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vegafactory-token-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "env": {
    "preview": {
      "workers_dev": false,
      "vars": {
        "OIDC_AUDIENCE": "vegastack-factory",
        "VEGAFACTORY_APP_ID": "4812956"
      },
      "secrets_store_secrets": [
        {
          "binding": "APP_PRIVATE_KEY",
          "store_id": "5cebcea1774c4596aba4ffcee25d57f1",
          "secret_name": "vegafactory-app-private-key"
        }
      ],
      "ratelimits": [
        {
          "name": "TOKEN_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "routes": [{ "pattern": "vegafactory-token.vegastack.dev", "custom_domain": true }],
      "observability": { "enabled": true }
    },
    "production": {
      "workers_dev": false,
      "vars": {
        "OIDC_AUDIENCE": "vegastack-factory",
        "VEGAFACTORY_APP_ID": "4812956"
      },
      "secrets_store_secrets": [
        {
          "binding": "APP_PRIVATE_KEY",
          "store_id": "5cebcea1774c4596aba4ffcee25d57f1",
          "secret_name": "vegafactory-app-private-key"
        }
      ],
      "ratelimits": [
        {
          "name": "TOKEN_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "routes": [{ "pattern": "vegafactory-token.vegastack.com", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
